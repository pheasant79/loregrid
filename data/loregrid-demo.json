    { "id": "pattern-review", "title": "模式复核", "tabId": "analysis", "summary": "检查模式是否来自偏差、遗漏或过拟合。", "outcome": "完成一份包含反例检查的分析备忘录。", "tags": ["复核", "模式"], "layout": { "order": 4 } },
    { "id": "analysis-brief", "title": "分析简报", "tabId": "analysis", "kind": "milestone", "summary": "把数据、模型和复核结果汇总为清晰结论。", "outcome": "交付一份可追溯到原始记录的简报。", "layout": { "order": 5 } },

    { "id": "mission-charter", "title": "任务章程", "tabId": "expeditions", "summary": "明确问题、范围、退出条件和职责。", "outcome": "形成团队可执行的任务章程。", "tags": ["协作", "范围"], "layout": { "order": 1 } },
    { "id": "remote-logistics", "title": "远程后勤", "tabId": "expeditions", "summary": "规划补给、通信、备件和撤离方案。", "outcome": "完成一份带冗余的后勤清单。", "tags": ["后勤", "风险"], "layout": { "order": 2 } },
    { "id": "anomaly-response", "title": "异常响应", "tabId": "expeditions", "kind": "optional", "summary": "为未知信号和设备异常建立分级响应。", "outcome": "通过一次桌面推演验证响应流程。", "caution": "示例不替代专业应急预案。", "tags": ["异常", "应急"], "layout": { "order": 3 } },
    { "id": "frontier-expedition", "title": "远境考察", "tabId": "expeditions", "kind": "milestone", "summary": "整合现场与分析能力完成一项复杂任务。", "outcome": "交付任务档案、数据、分析和复盘。", "layout": { "order": 4 } },
    { "id": "open-observatory", "title": "开放观测档案", "tabId": "expeditions", "kind": "milestone", "summary": "将可公开成果整理为可复用档案。", "outcome": "发布去敏、带来源和方法说明的档案。", "tags": ["开放", "复现"], "layout": { "order": 5 } }
