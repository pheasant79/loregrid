    { "id": "survey-mission", "title": "区域调查", "tabId": "fieldwork", "kind": "milestone", "summary": "执行一次小型区域调查。", "outcome": "交付路线、样本、日志和复盘。", "layout": { "order": 5 } },

    { "id": "data-hygiene", "title": "数据整理", "tabId": "analysis", "summary": "统一字段、单位和缺失值约定。", "outcome": "将原始记录转换为可分析数据集。", "tags": ["数据", "清理"], "layout": { "order": 1 } },
