    { "id": "safe-operations", "title": "安全操作", "tabId": "foundations", "summary": "识别现场、电力与设备风险。", "outcome": "能够为一项任务编写安全检查表。", "caution": "真实现场工作必须遵守当地规范与专业指导。", "resourceIds": ["handbook"], "tags": ["安全"], "layout": { "order": 2 } },
    { "id": "structured-notes", "title": "结构化记录", "tabId": "foundations", "summary": "用稳定字段记录时间、地点、条件和异常。", "outcome": "完成一份可由他人复核的观测记录。", "tags": ["记录", "复现"], "layout": { "order": 3 } },
    { "id": "basic-measurement", "title": "基础测量", "tabId": "foundations", "summary": "理解单位、精度、误差和校准。", "outcome": "能为一次测量报告数值与不确定性。", "tags": ["测量", "误差"], "layout": { "order": 4 } },
    { "id": "systems-check", "title": "系统联调", "tabId": "foundations", "kind": "milestone", "summary": "把安全、记录和测量流程组合成可运行系统。", "outcome": "完成一次受控环境中的端到端演练。", "layout": { "order": 5 } },

    { "id": "route-planning", "title": "路线规划", "tabId": "fieldwork", "summary": "根据目标、时间和风险规划调查路线。", "outcome": "生成包含备选路线的现场计划。", "resourceIds": ["mapping"], "tags": ["地图", "计划"], "layout": { "order": 1 } },
    { "id": "sample-protocol", "title": "采样协议", "tabId": "fieldwork", "summary": "定义样本选择、编号和交接规则。", "outcome": "编写一个可重复执行的采样协议。", "tags": ["采样", "协议"], "layout": { "order": 2 } },
    { "id": "environment-log", "title": "环境日志", "tabId": "fieldwork", "summary": "记录天气、地形和背景条件。", "outcome": "建立能与测量数据对齐的环境日志。", "tags": ["环境", "记录"], "layout": { "order": 3 } },
