{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pheasant79/loregrid/blob/main/schema/loregrid-tree-v2.schema.json",
  "title": "Loregrid tree v2",
  "type": "object",
  "required": ["format", "id", "title", "tabs", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "loregrid/tree-v2" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/text" },
    "subtitle": { "type": "string", "maxLength": 500 },
    "description": { "type": "string", "maxLength": 10000 },
    "version": { "type": "string", "maxLength": 100 },
    "language": { "type": "string", "maxLength": 35 },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/text" },
          "labelEn": { "type": "string", "maxLength": 200 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "order": { "type": "number" },
          "description": { "type": "string", "maxLength": 5000 }
        }
      }
    },
    "resources": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/text" },
          "url": { "type": "string", "pattern": "^https?://", "maxLength": 2048 },
          "scope": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "tabId"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/text" },
          "tabId": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["topic", "optional", "milestone"] },
          "summary": { "type": "string", "maxLength": 10000 },
          "outcome": { "type": "string", "maxLength": 10000 },
          "caution": { "type": "string", "maxLength": 10000 },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxItems": 100 },
          "resourceIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 100 },
          "layout": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "groupId": { "type": "string", "maxLength": 100 },
              "order": { "type": "number" },
              "stage": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/id" },
          "target": { "$ref": "#/$defs/id" },
          "type": { "enum": ["required", "recommended", "related"] },
          "label": { "type": "string", "maxLength": 500 },
          "reason": { "type": "string", "maxLength": 5000 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,95}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
