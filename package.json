{
  "name": "loregrid",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An offline-first learning tech tree with tabbed maps, research queues, progress tracking, and custom JSON trees.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/package-app.ts",
    "package:release": "pnpm build && tsx scripts/package-release.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "validate": "tsx scripts/validate.ts",
    "migrate": "tsx scripts/migrate-v1.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "jsdom": "^27.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.8"
  }
}
